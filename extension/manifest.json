{
  "manifest_version": 3,
  "name": "Azimuth OSINT helper",
  "version": "1.2.0",
  "description": "Companion to the Azimuth OSINT workbench: right-click investigate, Maigret username search (9,000+ sites), automatic page capture while recording, and Telegram channel reading.",
  "permissions": ["contextMenus", "storage", "unlimitedStorage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*", "https://*.github.io/*", "https://jamies.dev/*", "file:///*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": { "128": "icon.png" },
  "action": { "default_title": "Azimuth", "default_icon": "icon.png", "default_popup": "popup.html" }
}
